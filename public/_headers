# Netlify / Cloudflare Pages caching rules (Vercel uses vercel.json instead)

# Content-hashed build output: safe to cache forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Large static media that rarely changes (not hashed, so cache long but revalidate in background)
/island_frames/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
/*.mp4
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
/*.webm
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
/*.glb
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
